# --- provider keys (set only the ones you use; unkeyed models are skipped) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- candidate pool: add a model id here to add a provider, no code change ---
ROUTER_MODELS=gpt-5.4-nano,gpt-5.4-mini,gpt-5.5,claude-haiku-4-5,claude-sonnet-5,gemini/gemini-3.5-flash,groq/llama-3.3-70b-versatile
CLASSIFIER_MODEL=gpt-5.4-nano
FALLBACK_MODELS=gpt-5.4-mini,gemini/gemini-3.5-flash

# OpenAI-compatible endpoints. Known prefixes need nothing here -- just add the
# id to ROUTER_MODELS and set the key:
#   groq/...  deepseek/...  together_ai/...  openrouter/...  ollama/...
# Self-hosted /v1 servers (vLLM, LM Studio, LiteLLM proxy) need a base URL:
# MODEL_API_BASES=openai/qwen2.5-coder-32b=http://localhost:8000/v1,openai/local-llama=http://192.168.1.9:1234/v1
MODEL_API_BASES=
DEFAULT_PRIORITY=balanced

# --- reliability ---
NUM_RETRIES=3
REQUEST_TIMEOUT=60
CLASSIFIER_TIMEOUT=6

# --- caching ---
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_TTL=900
IDEMPOTENCY_TTL=86400

# --- rate limiting ---
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20

# --- auth: comma-separated client keys; leave empty to disable ---
API_KEYS=
LOG_LEVEL=INFO
