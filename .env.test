GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Candidate pool -- every id below was verified reachable with the keys above.
# Gemini for long-context + strongest general quality, Groq for raw speed on
# cheap tasks, NVIDIA NIM for open-weight models with a different failure domain
# (so a Groq outage doesn't take the whole router down).
ROUTER_MODELS=groq/llama-3.1-8b-instant,groq/llama-3.3-70b-versatile,groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash,nvidia_nim/openai/gpt-oss-120b,nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1.5,nvidia_nim/mistralai/mistral-nemotron

# Cheapest + fastest reachable model does the guardrail/intent pass.
CLASSIFIER_MODEL=groq/llama-3.1-8b-instant

# Fallbacks deliberately cross providers -- a Groq 429 should land on Gemini.
FALLBACK_MODELS=gemini/gemini-3.5-flash,groq/llama-3.3-70b-versatile

DEFAULT_PRIORITY=balanced
NUM_RETRIES=3
REQUEST_TIMEOUT=60
CLASSIFIER_TIMEOUT=6

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_TTL=900
IDEMPOTENCY_TTL=86400

RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20

API_KEYS=
LOG_LEVEL=WARNING
